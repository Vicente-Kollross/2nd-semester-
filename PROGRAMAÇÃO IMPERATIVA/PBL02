#include <stdio.h>

int main()
{
    int T, D, M;
    scanf("%d %d %d", &T, &D, &M);
    
    int ultimotempo = 0;
    int conseguiu = 0;
    
    for (int i = 0; i < M; i++){
        int y;
        scanf("%d", &y);
        
        if (y - ultimotempo >= T){
            conseguiu = 1;
        }
        
        ultimotempo = y;
    }
    
    if (D - ultimotempo >= T){
        conseguiu = 1;
    }
    
    if (conseguiu == 1){
        printf("Y\n");
    }
    
    else{
        printf("N\n");
    }
}
